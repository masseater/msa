{
  "name": "@msa/evals",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "shx rm -rf .eval",
    "eval": "vp run eval:host && vp run eval:docs",
    "eval:host": "vitest run --config vitest.evals.config.ts --project host",
    "eval:docs": "node --experimental-strip-types src/cli.ts",
    "test": "vitest run --config vitest.test.config.ts"
  },
  "dependencies": {
    "effect": "catalog:stack"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:stack",
    "@msa/ai": "workspace:*",
    "@msa/coding-agent": "workspace:*",
    "@msa/tui": "workspace:*",
    "@types/node": "catalog:",
    "@vitest-evals/core": "catalog:",
    "autoevals": "catalog:",
    "shx": "catalog:",
    "vitest": "catalog:",
    "vitest-evals": "catalog:"
  }
}
