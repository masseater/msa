{
  "name": "@msa/coding-agent",
  "version": "0.0.8",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "coding-agent",
    "llm",
    "tui"
  ],
  "license": "MIT",
  "author": "Mario Zechner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/msa.git",
    "directory": "apps/coding-agent"
  },
  "bin": {
    "msa": "dist/bundle/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "schemas",
    "containerization.md",
    "CHANGELOG.md",
    "LICENSES"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.types": {
      "types": "./dist/index.types.d.ts",
      "import": "./dist/index.types.js"
    },
    "./rpc-entry": {
      "import": "./dist/bundle/rpc-entry.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "copy-binary-assets": "shx cp package.json dist/ && shx cp README.md dist/ && shx cp CHANGELOG.md dist/ && shx mkdir -p dist/theme && shx cp src/modes/interactive/theme/*.json dist/theme/ && shx mkdir -p dist/export-html && shx cp src/core/export-html/template.css dist/export-html/ && shx cp -r docs dist/ && shx cp -r examples dist/ && shx cp node_modules/@silvia-odwyer/photon-node/photon_rs_bg.wasm dist/",
    "test": "vitest --run",
    "generate:schemas": "node --import ./src/experimental/source-resolver.ts scripts/generate-schemas.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@msa/agent-core": "workspace:*",
    "@msa/ai": "workspace:*",
    "@msa/chord": "workspace:*",
    "@msa/codemode": "workspace:*",
    "@msa/mcp": "workspace:*",
    "@msa/telemetry": "workspace:*",
    "@msa/tui": "workspace:*",
    "@secretlint/core": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@silvia-odwyer/photon-node": "catalog:",
    "brace-expansion": "catalog:",
    "chalk": "catalog:",
    "cross-spawn": "catalog:",
    "diff": "catalog:",
    "effect": "catalog:stack",
    "grok-mermaid": "catalog:",
    "highlight.js": "catalog:",
    "hosted-git-info": "catalog:",
    "ignore": "catalog:",
    "jiti": "catalog:",
    "minimatch": "catalog:",
    "node-llama-cpp": "catalog:",
    "proper-lockfile": "catalog:",
    "quickjs-wasi": "catalog:",
    "semver": "catalog:",
    "typebox": "catalog:",
    "undici": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:stack",
    "@msa/testing": "workspace:*",
    "@types/cross-spawn": "catalog:",
    "@types/hosted-git-info": "catalog:",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "@types/semver": "catalog:",
    "marked": "catalog:",
    "shx": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "protobufjs": "7.6.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "msaConfig": {
    "name": "msa",
    "configDir": ".msa"
  }
}
