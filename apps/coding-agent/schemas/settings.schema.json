{
  "$comment": "This file is generated from TypeScript source. Do not edit it manually; run npm run generate:schemas.",
  "$id": "https://raw.githubusercontent.com/masseater/msa/main/apps/coding-agent/schemas/settings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference."
    },
    "autocompleteMaxVisible": {
      "type": "number",
      "default": 5,
      "description": "Maximum visible items in the autocomplete dropdown."
    },
    "branchSummary": {
      "type": "object",
      "properties": {
        "reserveTokens": {
          "type": "number",
          "default": 16384,
          "description": "Tokens reserved for the prompt and LLM response."
        },
        "skipPrompt": {
          "type": "boolean",
          "default": false,
          "description": "When true, skips the \"Summarize branch?\" prompt and defaults to no summary."
        }
      }
    },
    "cacheWarming": {
      "anyOf": [
        {
          "type": "string",
          "const": "off"
        },
        {
          "type": "string",
          "const": "streaming"
        },
        {
          "type": "string",
          "const": "idle"
        }
      ],
      "default": "streaming",
      "description": "Cache-warming profile. \"idle\" also warms between agent runs. Global only because each refresh costs money."
    },
    "clipboardImageCommand": {
      "type": "string",
      "description": "Shell command whose stdout is the clipboard image, read by the paste key in place of the local clipboard. Global setting only."
    },
    "codemode": {
      "type": "object",
      "properties": {
        "inlineBudget": {
          "type": "number",
          "default": 3000,
          "description": "Estimated tokens available for inline codemode tool declarations.",
          "minimum": 0
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "on"
            },
            {
              "type": "string",
              "const": "only"
            }
          ],
          "default": "on",
          "description": "How codemode presents tools. \"on\" keeps direct tools declared and annotates tools callable from scripts; codemode lists only tools without direct exposure. \"only\" lists every script-callable tool in codemode and does not declare active direct tools."
        }
      }
    },
    "collapseChangelog": {
      "type": "boolean",
      "default": false,
      "description": "Show the condensed changelog after update; use /release-notes for the full changelog."
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "keepRecentTokens": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0,
          "default": 20000
        },
        "modelOverrides": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "properties": {
                "keepRecentTokens": {
                  "type": "integer",
                  "maximum": 9007199254740991,
                  "minimum": 0
                },
                "reserveTokens": {
                  "type": "integer",
                  "maximum": 9007199254740991,
                  "minimum": 0
                }
              }
            }
          },
          "description": "Per-model overrides keyed by exact \"provider/modelId\" strings."
        },
        "reserveTokens": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0,
          "default": 16384
        }
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "Classifier model that tools ask for decisions, as \"provider/id\". Default: local/liquid-d1-3b, run in process and downloaded on first use."
        },
        "thresholds": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "number",
              "maximum": 1,
              "minimum": 0
            }
          },
          "description": "Probability a decision must reach, keyed by \"<decision>.<question>\". Unset keys use the tool's own threshold."
        }
      }
    },
    "defaultModel": {
      "type": "string"
    },
    "defaultProjectTrust": {
      "anyOf": [
        {
          "type": "string",
          "const": "ask"
        },
        {
          "type": "string",
          "const": "always"
        },
        {
          "type": "string",
          "const": "never"
        }
      ],
      "default": "ask",
      "description": "Global setting only."
    },
    "defaultProvider": {
      "type": "string"
    },
    "defaultThinkingLevel": {
      "$ref": "#/$defs/ModelThinkingLevel"
    },
    "defaultTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Initial tool selection. Plain names replace the inherited selection; +name and -name entries add or remove tools."
    },
    "deviceId": {
      "type": "string",
      "description": "Stable installation UUID, generated when authentication first needs it. Global only."
    },
    "doubleEscapeAction": {
      "anyOf": [
        {
          "type": "string",
          "const": "fork"
        },
        {
          "type": "string",
          "const": "tree"
        },
        {
          "type": "string",
          "const": "none"
        }
      ],
      "default": "tree",
      "description": "Action for double-escape with an empty editor."
    },
    "editorPaddingX": {
      "type": "number",
      "default": 0,
      "description": "Horizontal padding for the input editor."
    },
    "enableAnalytics": {
      "type": "boolean",
      "default": false,
      "description": "Opt in to analytics data sharing."
    },
    "enableInstallTelemetry": {
      "type": "boolean",
      "default": true,
      "description": "Send attribution headers to OpenRouter."
    },
    "enableSkillCommands": {
      "type": "boolean",
      "default": true,
      "description": "Register skills as /name commands."
    },
    "enabledModels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Model patterns for cycling, in the same format as the --models CLI flag."
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local extension file paths or directories."
    },
    "externalEditor": {
      "type": "string",
      "description": "Command for Ctrl+G external editor; takes precedence over VISUAL and EDITOR."
    },
    "followUpMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "default": "one-at-a-time"
    },
    "fullscreenCopyOnSelect": {
      "type": "boolean",
      "default": true,
      "description": "No effect in regular TUI mode."
    },
    "fullscreenExitOutput": {
      "anyOf": [
        {
          "type": "string",
          "const": "transcript"
        },
        {
          "type": "string",
          "const": "resume-hint"
        }
      ],
      "default": "transcript",
      "description": "No effect in regular TUI mode."
    },
    "fullscreenScrollbar": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "always"
        },
        {
          "type": "string",
          "const": "hidden"
        }
      ],
      "default": "auto",
      "description": "No effect in regular TUI mode."
    },
    "fullscreenWheelScrollLines": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "auto"
        }
      ],
      "default": "auto",
      "description": "Lines scrolled per wheel event in fullscreen mode; numeric values are clamped from 1 to 100."
    },
    "goal": {
      "type": "object",
      "properties": {
        "evaluatorModel": {
          "type": "string",
          "description": "Model that judges /goal conditions, as \"provider/id\". Default: the strongest small model (haiku, flash, mini, lite, small) of the working model's provider, or the working model."
        }
      }
    },
    "hideThinkingBlock": {
      "type": "boolean",
      "default": true
    },
    "httpIdleTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ],
      "description": "HTTP header or body idle timeout in milliseconds; 0 or \"disabled\" disables it."
    },
    "httpProxy": {
      "type": "string",
      "description": "Proxy URL applied as HTTP_PROXY and HTTPS_PROXY for msa-managed HTTP clients."
    },
    "images": {
      "type": "object",
      "properties": {
        "autoResize": {
          "type": "boolean",
          "default": true,
          "description": "Resize images to 2000x2000 maximum for better model compatibility."
        },
        "blockImages": {
          "type": "boolean",
          "default": false,
          "description": "When true, prevents all images from being sent to LLM providers."
        }
      }
    },
    "lastChangelogVersion": {
      "type": "string"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "codeBlockIndent": {
          "type": "string",
          "default": "  "
        },
        "mermaid": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "final"
            },
            {
              "type": "string",
              "const": "streaming"
            }
          ],
          "default": "streaming"
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Long-term memory in sepiace: the built-in sepiace MCP server, the memory tool, recall, and the /memory command."
        },
        "recall": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Ask sepiace for memories relevant to each user prompt and add them to the run."
            }
          }
        }
      }
    },
    "modelPolicy": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Models that may be used, in the same format as the --models CLI flag. When set, models outside the list are unusable."
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Models that may not be used, in the same format as the --models CLI flag. A deny pattern wins over any allow pattern."
        }
      },
      "description": "Models a session may use. Deny wins, and a non-empty allow list restricts use to the models it names. Separate from enabledModels, which only narrows startup selection and Ctrl+P cycling."
    },
    "modelThinkingLevels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/ModelThinkingLevel"
        }
      },
      "description": "Per-model default thinking level overrides keyed by \"provider/modelId\"."
    },
    "notifyCommand": {
      "type": "string",
      "description": "Shell command run when msa stops and needs you, with the message in MSA_NOTIFY_MESSAGE. Global setting only."
    },
    "npmCommand": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Command used for npm package lookup and installation, in argv form such as [\"mise\", \"exec\", \"node@20\", \"--\", \"npm\"]."
    },
    "orchestrator": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "description": "SQLite file holding tasks, threads, reports, and notes. Default: <agent dir>/orchestrator.db."
        },
        "maxConcurrentThreads": {
          "type": "integer",
          "default": 4,
          "minimum": 1
        },
        "reviewModel": {
          "type": "string",
          "description": "Model of the review thread that closes each round, as \"provider/id\". Default: the orchestrator's model."
        },
        "reviewThinkingLevel": {
          "$ref": "#/$defs/ModelThinkingLevel"
        },
        "workerModel": {
          "type": "string",
          "description": "Model of the threads the orchestrator starts, as \"provider/id\", unless create_task names one. Default: the orchestrator's model."
        },
        "workerThinkingLevel": {
          "$ref": "#/$defs/ModelThinkingLevel"
        }
      }
    },
    "outputPad": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ],
      "default": 1,
      "description": "Horizontal padding for transcript content."
    },
    "packages": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "Load all resources from the package."
          },
          {
            "type": "object",
            "required": ["source"],
            "properties": {
              "autoload": {
                "type": "boolean",
                "description": "When false, start empty and only apply explicit resource patterns."
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              },
              "themes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "description": "Package source for npm or git packages. Use the string form to load all resources or the object form to filter resources."
      },
      "description": "npm or git package sources, as strings or objects with resource filtering."
    },
    "prWatch": {
      "type": "object",
      "properties": {
        "intervalSeconds": {
          "type": "number",
          "default": 45,
          "description": "Seconds between checks of a watched pull request.",
          "minimum": 5
        },
        "statusIntervalSeconds": {
          "type": "number",
          "default": 300,
          "description": "Seconds without a change before a watch reports its status again.",
          "minimum": 30
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local prompt template file paths or directories."
    },
    "queueMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "deprecated": true,
      "description": "Legacy setting migrated to steeringMode."
    },
    "quietStartup": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "header"
        }
      ],
      "default": false,
      "description": "When true, hide all startup output. When \"header\", keep only the startup header."
    },
    "retry": {
      "type": "object",
      "properties": {
        "baseDelayMs": {
          "type": "number",
          "default": 2000,
          "description": "Exponential backoff base delay in milliseconds: 2s, 4s, 8s."
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxAgentDelayMs": {
          "type": "number",
          "default": 60000
        },
        "maxDelayMs": {
          "type": "number",
          "deprecated": true,
          "description": "Legacy retry delay setting. Use provider.maxRetryDelayMs instead."
        },
        "maxRetries": {
          "type": "number",
          "default": 3
        },
        "provider": {
          "type": "object",
          "properties": {
            "maxRetries": {
              "type": "number",
              "description": "SDK or provider retry attempts."
            },
            "maxRetryDelayMs": {
              "type": "number",
              "default": 60000,
              "description": "Maximum server-requested delay before failing."
            },
            "timeoutMs": {
              "type": "number",
              "description": "SDK or provider request timeout in milliseconds."
            }
          }
        }
      }
    },
    "sessionDir": {
      "type": "string",
      "description": "Custom session storage directory, in the same format as the --session-dir CLI flag."
    },
    "shellCommandPrefix": {
      "type": "string",
      "description": "Prefix prepended to every bash command, for example to enable shell aliases."
    },
    "shellPath": {
      "type": "string",
      "description": "Custom shell path, for example for Cygwin on Windows, with support for leading ~ expansion."
    },
    "showCacheMissNotices": {
      "type": "boolean",
      "default": false,
      "description": "Show cache cost and provider recovery notices."
    },
    "showHardwareCursor": {
      "type": "boolean",
      "description": "Show the terminal cursor while still positioning it for IME."
    },
    "skills": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "customDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enableSkillCommands": {
              "type": "boolean"
            }
          },
          "deprecated": true
        }
      ],
      "description": "Local skill file paths or directories."
    },
    "steeringMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "default": "one-at-a-time"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "otlpEndpoint": {
          "type": "string",
          "description": "OTLP/HTTP base URL that receives traces, metrics, and logs, such as http://collector:4318. MSA_OTLP_ENDPOINT takes precedence. Default: the msa-grafana-lgtm podman container."
        }
      }
    },
    "terminal": {
      "type": "object",
      "properties": {
        "clearOnShrink": {
          "type": "boolean",
          "default": false,
          "description": "Clear empty rows when content shrinks."
        },
        "hyperlinks": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        },
        "imageWidthCells": {
          "type": "number",
          "default": 60,
          "description": "Preferred inline image width in terminal cells."
        },
        "images": {
          "anyOf": [
            {
              "type": "string",
              "const": "kitty"
            },
            {
              "type": "string",
              "const": "iterm2"
            },
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "showImages": {
          "type": "boolean",
          "default": true,
          "description": "Show images when the terminal supports them."
        },
        "showTerminalProgress": {
          "type": "boolean",
          "default": false,
          "description": "Show OSC 9;4 terminal progress indicators."
        },
        "trueColor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        }
      }
    },
    "theme": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local theme file paths or directories."
    },
    "thinkingBudgets": {
      "type": "object",
      "properties": {
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "medium": {
          "type": "number"
        },
        "minimal": {
          "type": "number"
        }
      },
      "description": "Custom token budgets for thinking levels."
    },
    "trackingId": {
      "type": "string",
      "description": "Analytics tracking identifier, generated when analytics is enabled."
    },
    "transport": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "sse"
        },
        {
          "type": "string",
          "const": "websocket"
        },
        {
          "type": "string",
          "const": "websocket-cached"
        }
      ],
      "default": "auto"
    },
    "treeFilterMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "default"
        },
        {
          "type": "string",
          "const": "no-tools"
        },
        {
          "type": "string",
          "const": "user-only"
        },
        {
          "type": "string",
          "const": "labeled-only"
        },
        {
          "type": "string",
          "const": "all"
        }
      ],
      "default": "default",
      "description": "Default filter when opening /tree."
    },
    "tuiMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "regular"
        },
        {
          "type": "string",
          "const": "fullscreen"
        }
      ],
      "default": "fullscreen"
    },
    "websocketConnectTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ],
      "description": "WebSocket connect or open handshake timeout in milliseconds; 0 or \"disabled\" disables it."
    },
    "websockets": {
      "type": "boolean",
      "deprecated": true,
      "description": "Legacy setting migrated to transport."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ModelThinkingLevel": {
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
    }
  }
}
