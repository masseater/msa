{
  "$comment": "This file is generated from TypeScript source. Do not edit it manually; run npm run generate:schemas.",
  "$id": "https://raw.githubusercontent.com/masseater/msa/main/apps/coding-agent/schemas/settings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference."
    },
    "autocompleteMaxVisible": {
      "type": "number",
      "description": "Maximum visible items in the autocomplete dropdown.",
      "default": 5
    },
    "branchSummary": {
      "type": "object",
      "properties": {
        "reserveTokens": {
          "type": "number",
          "default": 16384,
          "description": "Tokens reserved for the prompt and LLM response."
        },
        "skipPrompt": {
          "type": "boolean",
          "default": false,
          "description": "When true, skips the \"Summarize branch?\" prompt and defaults to no summary."
        }
      }
    },
    "cacheWarming": {
      "anyOf": [
        {
          "type": "string",
          "const": "off"
        },
        {
          "type": "string",
          "const": "streaming"
        },
        {
          "type": "string",
          "const": "idle"
        }
      ],
      "description": "Cache-warming profile. \"idle\" also warms between agent runs. Global only because each refresh costs money.",
      "default": "streaming"
    },
    "clipboardImageCommand": {
      "type": "string",
      "description": "Shell command whose stdout is the clipboard image, read by the paste key in place of the local clipboard. Global setting only."
    },
    "codemode": {
      "type": "object",
      "properties": {
        "inlineBudget": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated tokens available for inline codemode tool declarations.",
          "default": 3000
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "on"
            },
            {
              "type": "string",
              "const": "only"
            }
          ],
          "description": "How codemode presents tools. \"on\" keeps direct tools declared and annotates tools callable from scripts; codemode lists only tools without direct exposure. \"only\" lists every script-callable tool in codemode and does not declare active direct tools.",
          "default": "on"
        }
      }
    },
    "collapseChangelog": {
      "type": "boolean",
      "description": "Show the condensed changelog after update; use /release-notes for the full changelog.",
      "default": false
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "keepRecentTokens": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0,
          "default": 20000
        },
        "modelOverrides": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "properties": {
                "keepRecentTokens": {
                  "type": "integer",
                  "maximum": 9007199254740991,
                  "minimum": 0
                },
                "reserveTokens": {
                  "type": "integer",
                  "maximum": 9007199254740991,
                  "minimum": 0
                }
              }
            }
          },
          "description": "Per-model overrides keyed by exact \"provider/modelId\" strings."
        },
        "reserveTokens": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0,
          "default": 16384
        }
      }
    },
    "defaultModel": {
      "type": "string"
    },
    "defaultProjectTrust": {
      "anyOf": [
        {
          "type": "string",
          "const": "ask"
        },
        {
          "type": "string",
          "const": "always"
        },
        {
          "type": "string",
          "const": "never"
        }
      ],
      "description": "Global setting only.",
      "default": "ask"
    },
    "defaultProvider": {
      "type": "string"
    },
    "defaultThinkingLevel": {
      "$ref": "#/$defs/ModelThinkingLevel"
    },
    "defaultTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Initial tool selection. Plain names replace the inherited selection; +name and -name entries add or remove tools."
    },
    "deviceId": {
      "type": "string",
      "description": "Stable installation UUID, generated when authentication first needs it. Global only."
    },
    "doubleEscapeAction": {
      "anyOf": [
        {
          "type": "string",
          "const": "fork"
        },
        {
          "type": "string",
          "const": "tree"
        },
        {
          "type": "string",
          "const": "none"
        }
      ],
      "description": "Action for double-escape with an empty editor.",
      "default": "tree"
    },
    "editorPaddingX": {
      "type": "number",
      "description": "Horizontal padding for the input editor.",
      "default": 0
    },
    "enableAnalytics": {
      "type": "boolean",
      "description": "Opt in to analytics data sharing.",
      "default": false
    },
    "enableInstallTelemetry": {
      "type": "boolean",
      "description": "Send attribution headers to OpenRouter.",
      "default": true
    },
    "enableSkillCommands": {
      "type": "boolean",
      "description": "Register skills as /name commands.",
      "default": true
    },
    "enabledModels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Model patterns for cycling, in the same format as the --models CLI flag."
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local extension file paths or directories."
    },
    "externalEditor": {
      "type": "string",
      "description": "Command for Ctrl+G external editor; takes precedence over VISUAL and EDITOR."
    },
    "followUpMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "default": "one-at-a-time"
    },
    "fullscreenCopyOnSelect": {
      "type": "boolean",
      "description": "No effect in regular TUI mode.",
      "default": true
    },
    "fullscreenExitOutput": {
      "anyOf": [
        {
          "type": "string",
          "const": "transcript"
        },
        {
          "type": "string",
          "const": "resume-hint"
        }
      ],
      "description": "No effect in regular TUI mode.",
      "default": "transcript"
    },
    "fullscreenScrollbar": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "always"
        },
        {
          "type": "string",
          "const": "hidden"
        }
      ],
      "description": "No effect in regular TUI mode.",
      "default": "auto"
    },
    "fullscreenWheelScrollLines": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "auto"
        }
      ],
      "description": "Lines scrolled per wheel event in fullscreen mode; numeric values are clamped from 1 to 100.",
      "default": "auto"
    },
    "goal": {
      "type": "object",
      "properties": {
        "evaluatorModel": {
          "type": "string",
          "description": "Model that judges /goal conditions, as \"provider/id\". Default: the strongest small model (haiku, flash, mini, lite, small) of the working model's provider, or the working model."
        }
      }
    },
    "hideThinkingBlock": {
      "type": "boolean",
      "default": true
    },
    "httpIdleTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ],
      "description": "HTTP header or body idle timeout in milliseconds; 0 or \"disabled\" disables it."
    },
    "httpProxy": {
      "type": "string",
      "description": "Proxy URL applied as HTTP_PROXY and HTTPS_PROXY for msa-managed HTTP clients."
    },
    "images": {
      "type": "object",
      "properties": {
        "autoResize": {
          "type": "boolean",
          "default": true,
          "description": "Resize images to 2000x2000 maximum for better model compatibility."
        },
        "blockImages": {
          "type": "boolean",
          "default": false,
          "description": "When true, prevents all images from being sent to LLM providers."
        }
      }
    },
    "lastChangelogVersion": {
      "type": "string"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "codeBlockIndent": {
          "type": "string",
          "default": "  "
        },
        "mermaid": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "final"
            },
            {
              "type": "string",
              "const": "streaming"
            }
          ],
          "default": "streaming"
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "description": "SQLite file holding memories. Default: <agent dir>/memory.db."
        },
        "embedding": {
          "type": "object",
          "properties": {
            "apiKeyEnv": {
              "type": "string",
              "description": "Environment variable holding the API key, for endpoints that need one."
            },
            "baseUrl": {
              "type": "string",
              "description": "OpenAI-compatible base URL such as http://127.0.0.1:11434/v1 (Ollama) or https://api.openai.com/v1. /embeddings is appended.",
              "default": "http://127.0.0.1:11434/v1"
            },
            "documentPrefix": {
              "type": "string",
              "description": "Prepended to memory text before embedding.",
              "default": "title: none | text: "
            },
            "enabled": {
              "type": "boolean",
              "description": "Compute embeddings so memories are searchable by meaning, not only keywords.",
              "default": true
            },
            "model": {
              "type": "string",
              "description": "Embedding model name at that endpoint.",
              "default": "embeddinggemma-2"
            },
            "queryPrefix": {
              "type": "string",
              "description": "Prepended to search queries, for models trained with task prefixes (EmbeddingGemma). Clear it for models that use none.",
              "default": "task: search result | query: "
            },
            "timeoutMs": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0,
              "description": "Embedding request timeout in milliseconds.",
              "default": 5000
            }
          }
        },
        "enabled": {
          "type": "boolean",
          "description": "Long-term memory: the memory tool, recall, and the /memory command.",
          "default": true
        },
        "recall": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Recall memories relevant to each user prompt and add them to the run."
            },
            "limit": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0,
              "default": 5,
              "description": "Maximum memories added to a run."
            },
            "minScore": {
              "type": "number",
              "default": 0.72,
              "description": "Minimum relevance (0-1) for a memory to be recalled: its embedding similarity, or the share of query words it holds. Embedding models differ in their score range, so tune this with the model."
            }
          }
        }
      }
    },
    "modelPolicy": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Models that may be used, in the same format as the --models CLI flag. When set, models outside the list are unusable."
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Models that may not be used, in the same format as the --models CLI flag. A deny pattern wins over any allow pattern."
        }
      },
      "description": "Models a session may use. Deny wins, and a non-empty allow list restricts use to the models it names. Separate from enabledModels, which only narrows startup selection and Ctrl+P cycling."
    },
    "modelThinkingLevels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/ModelThinkingLevel"
        }
      },
      "description": "Per-model default thinking level overrides keyed by \"provider/modelId\"."
    },
    "npmCommand": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Command used for npm package lookup and installation, in argv form such as [\"mise\", \"exec\", \"node@20\", \"--\", \"npm\"]."
    },
    "orchestrator": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "description": "SQLite file holding tasks, threads, reports, and notes. Default: <agent dir>/orchestrator.db."
        },
        "workerModel": {
          "type": "string",
          "description": "Model of the threads the orchestrator starts, as \"provider/id\", unless create_task names one. Default: the orchestrator's model."
        },
        "workerThinkingLevel": {
          "$ref": "#/$defs/ModelThinkingLevel"
        },
        "reviewModel": {
          "type": "string",
          "description": "Model of the review thread that closes each round, as \"provider/id\". Default: the orchestrator's model."
        },
        "reviewThinkingLevel": {
          "$ref": "#/$defs/ModelThinkingLevel"
        },
        "maxConcurrentThreads": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        }
      }
    },
    "outputPad": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ],
      "description": "Horizontal padding for transcript content.",
      "default": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "Load all resources from the package."
          },
          {
            "type": "object",
            "required": ["source"],
            "properties": {
              "autoload": {
                "type": "boolean",
                "description": "When false, start empty and only apply explicit resource patterns."
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              },
              "themes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "description": "Package source for npm or git packages. Use the string form to load all resources or the object form to filter resources."
      },
      "description": "npm or git package sources, as strings or objects with resource filtering."
    },
    "prWatch": {
      "type": "object",
      "properties": {
        "intervalSeconds": {
          "type": "number",
          "default": 45,
          "description": "Seconds between checks of a watched pull request.",
          "minimum": 5
        },
        "statusIntervalSeconds": {
          "type": "number",
          "default": 300,
          "description": "Seconds without a change before a watch reports its status again.",
          "minimum": 30
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local prompt template file paths or directories."
    },
    "queueMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "description": "Legacy setting migrated to steeringMode.",
      "deprecated": true
    },
    "quietStartup": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "header"
        }
      ],
      "description": "When true, hide all startup output. When \"header\", keep only the startup header.",
      "default": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "baseDelayMs": {
          "type": "number",
          "description": "Exponential backoff base delay in milliseconds: 2s, 4s, 8s.",
          "default": 2000
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxAgentDelayMs": {
          "type": "number",
          "default": 60000
        },
        "maxDelayMs": {
          "type": "number",
          "description": "Legacy retry delay setting. Use provider.maxRetryDelayMs instead.",
          "deprecated": true
        },
        "maxRetries": {
          "type": "number",
          "default": 3
        },
        "provider": {
          "type": "object",
          "properties": {
            "maxRetries": {
              "type": "number",
              "description": "SDK or provider retry attempts."
            },
            "maxRetryDelayMs": {
              "type": "number",
              "description": "Maximum server-requested delay before failing.",
              "default": 60000
            },
            "timeoutMs": {
              "type": "number",
              "description": "SDK or provider request timeout in milliseconds."
            }
          }
        }
      }
    },
    "sessionDir": {
      "type": "string",
      "description": "Custom session storage directory, in the same format as the --session-dir CLI flag."
    },
    "shellCommandPrefix": {
      "type": "string",
      "description": "Prefix prepended to every bash command, for example to enable shell aliases."
    },
    "shellPath": {
      "type": "string",
      "description": "Custom shell path, for example for Cygwin on Windows, with support for leading ~ expansion."
    },
    "showCacheMissNotices": {
      "type": "boolean",
      "description": "Show cache cost and provider recovery notices.",
      "default": false
    },
    "showHardwareCursor": {
      "type": "boolean",
      "description": "Show the terminal cursor while still positioning it for IME."
    },
    "skills": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "customDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enableSkillCommands": {
              "type": "boolean"
            }
          },
          "deprecated": true
        }
      ],
      "description": "Local skill file paths or directories."
    },
    "steeringMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ],
      "default": "one-at-a-time"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "otlpEndpoint": {
          "type": "string",
          "description": "OTLP/HTTP base URL that receives traces, metrics, and logs, such as http://collector:4318. MSA_OTLP_ENDPOINT takes precedence. Default: the msa-grafana-lgtm podman container."
        }
      }
    },
    "terminal": {
      "type": "object",
      "properties": {
        "clearOnShrink": {
          "type": "boolean",
          "description": "Clear empty rows when content shrinks.",
          "default": false
        },
        "hyperlinks": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        },
        "imageWidthCells": {
          "type": "number",
          "description": "Preferred inline image width in terminal cells.",
          "default": 60
        },
        "images": {
          "anyOf": [
            {
              "type": "string",
              "const": "kitty"
            },
            {
              "type": "string",
              "const": "iterm2"
            },
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "showImages": {
          "type": "boolean",
          "description": "Show images when the terminal supports them.",
          "default": true
        },
        "showTerminalProgress": {
          "type": "boolean",
          "description": "Show OSC 9;4 terminal progress indicators.",
          "default": false
        },
        "trueColor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        }
      }
    },
    "theme": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local theme file paths or directories."
    },
    "thinkingBudgets": {
      "type": "object",
      "properties": {
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "medium": {
          "type": "number"
        },
        "minimal": {
          "type": "number"
        }
      },
      "description": "Custom token budgets for thinking levels."
    },
    "trackingId": {
      "type": "string",
      "description": "Analytics tracking identifier, generated when analytics is enabled."
    },
    "transport": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "sse"
        },
        {
          "type": "string",
          "const": "websocket"
        },
        {
          "type": "string",
          "const": "websocket-cached"
        }
      ],
      "default": "auto"
    },
    "treeFilterMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "default"
        },
        {
          "type": "string",
          "const": "no-tools"
        },
        {
          "type": "string",
          "const": "user-only"
        },
        {
          "type": "string",
          "const": "labeled-only"
        },
        {
          "type": "string",
          "const": "all"
        }
      ],
      "description": "Default filter when opening /tree.",
      "default": "default"
    },
    "tuiMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "regular"
        },
        {
          "type": "string",
          "const": "fullscreen"
        }
      ],
      "default": "fullscreen"
    },
    "websocketConnectTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ],
      "description": "WebSocket connect or open handshake timeout in milliseconds; 0 or \"disabled\" disables it."
    },
    "websockets": {
      "type": "boolean",
      "description": "Legacy setting migrated to transport.",
      "deprecated": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ModelThinkingLevel": {
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
    }
  }
}
