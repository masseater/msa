                    },
                    "p75": {
                      "type": "number",
                      "description": "Minimum tokens per second at the 75th percentile."
                    },
                    "p90": {
                      "type": "number",
                      "description": "Minimum tokens per second at the 90th percentile."
                    },
                    "p99": {
                      "type": "number",
                      "description": "Minimum tokens per second at the 99th percentile."
                    }
                  }
                }
              ],
              "description": "Preferred minimum throughput in tokens per second. A number applies to p50."
            },
            "quantizations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "A list of quantization levels to filter providers by, for example [\"fp16\", \"bf16\", \"fp8\", \"fp6\", \"int8\", \"int4\", \"fp4\", \"fp32\"]."
