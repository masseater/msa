                        },
                        {
                          "type": "string",
                          "const": "thinking.budget"
                        }
                      ]
                    },
                    "omitWhenOff": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "description": "Kwargs sent as chat_template_kwargs when thinkingFormat is \"chat-template\". Use $var with \"thinking.enabled\", \"thinking.effort\", or \"thinking.budget\" for msa-controlled values."
