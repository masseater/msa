{
  "name": "msa-monorepo",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "vp run -r clean",
    "build": "vp run -r --concurrency-limit 1 build",
    "build:offline": "vp run --filter @msa/ai build:offline && vp run --filter '!msa-monorepo' --filter '!@msa/ai' --concurrency-limit 1 build",
    "build:native:darwin": "vp run --filter @msa/tui build:native:darwin",
    "build:native:linux": "vp run --filter @msa/tui build:native:linux",
    "build:native:win32": "vp run --filter @msa/tui build:native:win32",
    "check:browser-smoke": "node scripts/check-browser-smoke.mjs",
    "check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
    "check:entry-graphs": "node scripts/check-entry-graphs.mjs",
    "fence:counts": "node tools/fence-counts.ts --write",
    "fence:check": "node tools/fence-counts.ts",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dead-code --no-production --fail-on-issues --quiet --format compact && fallow dead-code --no-production --quiet --format json | jq -e '[.prop_drilling_chains, .thin_wrappers, .duplicate_prop_shapes] | all(length == 0)' > /dev/null && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet",
    "generate:models": "vp run --filter @msa/ai generate-models",
    "hydrate:model-data": "vp run --filter @msa/ai hydrate-model-data",
    "check:model-data": "vp run --filter @msa/ai check:model-data",
    "generate:model-catalog": "vp run --filter @msa/ai generate-model-catalog",
    "eval": "vp run --filter @msa/evals eval",
    "profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
    "profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
    "test:scripts": "node --test scripts/*.test.mjs scripts/*.test.ts",
    "test:mcp-conformance": "node apps/coding-agent/test/mcp-conformance/run.ts",
    "prepare": "vp config --no-agent && effect-tsgo patch --no-typescript --oxlint && skills experimental_install --force"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "catalog:",
    "@ast-grep/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "esbuild": "catalog:",
    "eslint-plugin-no-comments": "catalog:",
    "fallow": "catalog:stack",
    "shx": "catalog:",
    "skills": "catalog:",
    "syncpack": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:stack",
    "yaml": "catalog:"
  },
  "overrides": {
    "protobufjs": "7.6.6"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
