{
  "name": "msa-monorepo",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && effect-tsgo patch --oxlint && skills experimental_install --force"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "catalog:",
    "@ast-grep/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@jridgewell/remapping": "catalog:",
    "@picocss/pico": "catalog:",
    "@types/d3-array": "catalog:",
    "@types/node": "catalog:",
    "charts.css": "catalog:",
    "d3-array": "catalog:",
    "effect": "catalog:stack",
    "es-module-lexer": "catalog:",
    "esbuild": "catalog:",
    "eslint-plugin-no-comments": "catalog:",
    "fallow": "catalog:stack",
    "magic-string": "catalog:",
    "shx": "catalog:",
    "skills": "catalog:",
    "srvx": "catalog:",
    "syncpack": "catalog:",
    "tree-sitter-bash": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:stack",
    "web-tree-sitter": "catalog:",
    "yaml": "catalog:"
  },
  "overrides": {
    "protobufjs": "7.6.6"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        0
      ]
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
