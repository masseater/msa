{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "enabledManagers": ["nodenv"],
  "packageRules": [
    {
      "matchManagers": ["nodenv"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "automerge": true,
  "ignoreTests": true
}
