{
  "name": "@msa/testing",
  "version": "0.0.3",
  "description": "Effect test support shared by msa packages",
  "keywords": [
    "effect",
    "testing"
  ],
  "license": "MIT",
  "author": "Earendil Works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/msa.git",
    "directory": "libs/testing"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.types": {
      "source": "./src/index.types.ts",
      "types": "./dist/index.types.d.ts",
      "import": "./dist/index.types.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:stack"
  },
  "devDependencies": {
    "shx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
