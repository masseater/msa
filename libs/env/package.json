{
  "name": "@msa/env",
  "version": "0.0.4",
  "description": "Remote execution environments for msa Durable: a small daemon deployed over SSH and its ExecutionEnv client",
  "keywords": [
    "agents",
    "durable-execution",
    "remote",
    "ssh"
  ],
  "license": "MIT",
  "author": "Earendil Works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/msa.git",
    "directory": "libs/env"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index.types": {
      "source": "./src/index.types.ts",
      "types": "./dist/index.types.d.ts",
      "import": "./dist/index.types.js",
      "default": "./dist/index.types.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build:daemon": "cd daemon && cargo build --locked",
    "test": "vitest --run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@msa/chord": "workspace:*",
    "@msa/durable": "workspace:*",
    "effect": "catalog:stack"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:stack",
    "@msa/testing": "workspace:*",
    "shx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
