{
  "name": "@msa/mcp",
  "version": "0.0.4",
  "description": "Standalone Model Context Protocol client for msa and other applications",
  "keywords": [
    "client",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Earendil Works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/msa.git",
    "directory": "libs/mcp"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.types": {
      "source": "./src/index.types.ts",
      "types": "./dist/index.types.d.ts",
      "import": "./dist/index.types.js"
    },
    "./oauth": {
      "source": "./src/oauth/index.ts",
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./oauth.types": {
      "source": "./src/oauth/index.types.ts",
      "types": "./dist/oauth/index.types.d.ts",
      "import": "./dist/oauth/index.types.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing.types": {
      "source": "./src/testing/index.types.ts",
      "types": "./dist/testing/index.types.d.ts",
      "import": "./dist/testing/index.types.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "test": "vitest --run"
  },
  "dependencies": {
    "@msa/chord": "workspace:*",
    "cross-spawn": "catalog:",
    "effect": "catalog:stack",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:stack",
    "@msa/testing": "workspace:*",
    "@types/cross-spawn": "catalog:",
    "shx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
