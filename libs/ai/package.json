{
  "name": "@msa/ai",
  "version": "0.0.4",
  "description": "Unified LLM API with automatic model discovery and provider configuration",
  "keywords": [
    "ai",
    "anthropic",
    "api",
    "gemini",
    "llm",
    "openai",
    "unified"
  ],
  "license": "MIT",
  "author": "Mario Zechner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/msa.git",
    "directory": "libs/ai"
  },
  "bin": {
    "msa-ai": "dist/bin/msa-ai.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/compat.js",
    "./dist/images.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.types": {
      "source": "./src/index.types.ts",
      "types": "./dist/index.types.d.ts",
      "import": "./dist/index.types.js"
    },
    "./models/types": {
      "source": "./src/models/types.ts",
      "types": "./dist/models/types.d.ts",
      "import": "./dist/models/types.js"
    },
    "./models": {
      "source": "./src/models.ts",
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./models.types": {
      "source": "./src/models.types.ts",
      "types": "./dist/models.types.d.ts",
      "import": "./dist/models.types.js"
    },
    "./compat": {
      "source": "./src/compat.ts",
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./compat.types": {
      "source": "./src/compat.types.ts",
      "types": "./dist/compat.types.d.ts",
      "import": "./dist/compat.types.js"
    },
    "./providers/*": {
      "source": "./src/providers/*.ts",
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./api/*": {
      "source": "./src/api/*.ts",
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    },
    "./utils/*": {
      "source": "./src/utils/*.ts",
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./oauth": {
      "source": "./src/oauth.ts",
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./oauth.types": {
      "source": "./src/oauth.types.ts",
      "types": "./dist/oauth.types.d.ts",
      "import": "./dist/oauth.types.js"
    },
    "./*.types": {
      "source": "./src/*.types.ts",
      "types": "./dist/*.types.d.ts",
      "import": "./dist/*.types.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "generate-models": "node scripts/generate-models.ts --strict",
    "hydrate-model-data": "node scripts/generate-models.ts --strict --data-only",
    "generate-model-catalog": "node scripts/generate-models.ts --strict --json-only --json-output ../../.artifacts/model-catalog",
    "build": "vp run generate-models && vp run build:offline",
    "build:offline": "tsc -p tsconfig.build.json && shx rm -rf dist/providers/data && shx cp -r src/providers/data dist/providers/data && vp pack",
    "test": "vitest --run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@effect/platform-node": "catalog:",
    "@google/genai": "catalog:",
    "@msa/telemetry": "workspace:*",
    "effect": "catalog:stack",
    "node-llama-cpp": "catalog:",
    "openai": "catalog:",
    "partial-json": "catalog:",
    "srvx": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:stack",
    "@msa/testing": "workspace:*",
    "@types/node": "catalog:",
    "canvas": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
