{
  "name": "@msa/telemetry",
  "version": "0.0.4",
  "description": "Vendor-neutral telemetry contracts and typed schema utilities for msa",
  "keywords": [
    "observability",
    "telemetry",
    "tracing"
  ],
  "license": "MIT",
  "author": "Mario Zechner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/msa.git",
    "directory": "libs/telemetry"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.types": {
      "types": "./dist/index.types.d.ts",
      "import": "./dist/index.types.js"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "import": "./dist/otlp.js"
    },
    "./otlp.types": {
      "types": "./dist/otlp.types.d.ts",
      "import": "./dist/otlp.types.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing.types": {
      "types": "./dist/testing/index.types.d.ts",
      "import": "./dist/testing/index.types.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "test": "vitest --run"
  },
  "dependencies": {
    "effect": "catalog:stack"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:stack",
    "@msa/testing": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
