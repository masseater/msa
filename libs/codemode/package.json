{
  "name": "@msa/codemode",
  "version": "0.0.3",
  "description": "Sandboxed JavaScript execution where the only capability is calling injected tools",
  "keywords": [
    "cloudflare",
    "codemode",
    "durable-objects",
    "msa",
    "quickjs",
    "sandbox",
    "wasm"
  ],
  "license": "MIT",
  "author": "Earendil Works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/msa.git",
    "directory": "libs/codemode"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./declarations": {
      "source": "./src/declarations.ts",
      "types": "./dist/declarations.d.ts",
      "import": "./dist/declarations.js"
    },
    "./source": {
      "source": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./portable": {
      "source": "./src/portable.ts",
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    },
    "./cloudflare": {
      "source": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./worker": {
      "source": "./src/runtime/worker.ts",
      "types": "./dist/runtime/worker.d.ts",
      "import": "./dist/runtime/worker.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:stack",
    "quickjs-wasi": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:stack",
    "shx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
