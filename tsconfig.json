{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@msa/chord": ["./libs/chord/src/index.ts"],
      "@msa/chord/context": ["./libs/chord/src/context/index.ts"],
      "@msa/chord/delta": ["./libs/chord/src/delta/index.ts"],
      "@msa/chord/node": ["./libs/chord/src/node.ts"],
      "@msa/chord/output": ["./libs/chord/src/output.ts"],
      "@msa/telemetry": ["./libs/telemetry/src/index.ts"],
      "@msa/telemetry/testing": ["./libs/telemetry/src/testing/index.ts"],
      "@msa/codemode": ["./libs/codemode/src/index.ts"],
      "@msa/codemode/cloudflare": ["./libs/codemode/src/cloudflare.ts"],
      "@msa/codemode/declarations": ["./libs/codemode/src/declarations.ts"],
      "@msa/codemode/portable": ["./libs/codemode/src/portable.ts"],
      "@msa/codemode/source": ["./libs/codemode/src/source.ts"],
      "@msa/codemode/worker": ["./libs/codemode/src/runtime/worker.ts"],
      "@msa/codemode/worker-main": ["./libs/codemode/src/runtime/worker-main.ts"],
      "@msa/mcp": ["./libs/mcp/src/index.ts"],
      "@msa/mcp/oauth": ["./libs/mcp/src/oauth/index.ts"],
      "@msa/mcp/testing": ["./libs/mcp/src/testing/index.ts"],
      "@msa/ai": ["./libs/ai/src/index.ts"],
      "@msa/ai/oauth": ["./libs/ai/src/oauth.ts"],
      "@msa/ai/*": ["./libs/ai/src/*.ts", "./libs/ai/src/providers/*.ts"],
      "@msa/ai/dist/*": ["./libs/ai/src/*"],
      "@msa/durable": ["./libs/durable/src/index.ts"],
      "@msa/durable/testing": ["./libs/durable/src/testing/index.ts"],
      "@msa/durable/*": [
        "./libs/durable/src/*.ts",
        "./libs/durable/src/*/index.ts",
        "./libs/durable/src/*"
      ],
      "@msa/env": ["./libs/env/src/index.ts"],
      "@msa/agent-core": ["./libs/agent/src/index.ts"],
      "@msa/coding-agent": ["./apps/coding-agent/src/index.ts"],
      "@msa/coding-agent/hooks": ["./apps/coding-agent/src/core/hooks/index.ts"],
      "@msa/coding-agent/*": ["./apps/coding-agent/src/*"],
      "typebox": ["./node_modules/typebox"],
      "@msa/tui": ["./libs/tui/src/index.ts"],
      "@msa/tui/*": ["./libs/tui/src/*"]
    }
  },
  "include": [
    "*.ts",
    "tools/**/*.ts",
    "scripts/**/*.ts",
    ".msa/extensions/**/*.ts",
    "apps/*/src/**/*",
    "apps/*/test/**/*",
    "apps/coding-agent/scripts/**/*.ts",
    "libs/*/src/**/*",
    "libs/*/test/**/*",
    "libs/ai/scripts/**/*.ts",
    "libs/tui/native/**/*.ts",
    "apps/coding-agent/examples/**/*",
    "libs/agent/examples/**/*"
  ],
  "exclude": ["**/dist/**", "apps/coding-agent/examples/extensions/gondolin/**"]
}
