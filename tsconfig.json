{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@msa/chord": ["./packages/chord/src/index.ts"],
      "@msa/chord/context": ["./packages/chord/src/context/index.ts"],
      "@msa/chord/delta": ["./packages/chord/src/delta/index.ts"],
      "@msa/chord/node": ["./packages/chord/src/node.ts"],
      "@msa/chord/output": ["./packages/chord/src/output.ts"],
      "@msa/telemetry": ["./packages/telemetry/src/index.ts"],
      "@msa/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
      "@msa/codemode": ["./packages/codemode/src/index.ts"],
      "@msa/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
      "@msa/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
      "@msa/codemode/portable": ["./packages/codemode/src/portable.ts"],
      "@msa/codemode/source": ["./packages/codemode/src/source.ts"],
      "@msa/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
      "@msa/mcp": ["./packages/mcp/src/index.ts"],
      "@msa/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
      "@msa/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
      "@msa/ai": ["./packages/ai/src/index.ts"],
      "@msa/ai/oauth": ["./packages/ai/src/oauth.ts"],
      "@msa/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
      "@msa/ai/dist/*": ["./packages/ai/src/*"],
      "@msa/durable": ["./packages/durable/src/index.ts"],
      "@msa/durable/testing": ["./packages/durable/src/testing/index.ts"],
      "@msa/durable/*": [
        "./packages/durable/src/*.ts",
        "./packages/durable/src/*/index.ts",
        "./packages/durable/src/*"
      ],
      "@msa/env": ["./packages/env/src/index.ts"],
      "@msa/agent-core": ["./packages/agent/src/index.ts"],
      "@msa/coding-agent": ["./packages/coding-agent/src/index.ts"],
      "@msa/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
      "@msa/coding-agent/*": ["./packages/coding-agent/src/*"],
      "typebox": ["./node_modules/typebox"],
      "@msa/tui": ["./packages/tui/src/index.ts"],
      "@msa/tui/*": ["./packages/tui/src/*"]
    }
  },
  "include": [
    "*.ts",
    "tools/**/*.ts",
    "scripts/model-catalog-protocol.ts",
    "scripts/model-catalog-protocol.test.ts",
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/coding-agent/examples/**/*",
    "packages/agent/examples/**/*"
  ],
  "exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
