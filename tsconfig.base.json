{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "lib": ["ES2024"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "inlineSourceMap": false,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeChildProcessSpawner#layer",
          "@effect/platform-node-shared/NodeSink#fromWritable",
          "@effect/platform-node-shared/NodeStream#fromReadable",
          "@effect/platform-node/NodeCrypto#layer",
          "@effect/platform-node/NodeFileSystem#layer",
          "@effect/platform-node/NodeHttpClient#layerUndici",
          "@effect/platform-node/NodeHttpServer#layerTest",
          "@effect/platform-node/NodePath#layer",
          "@effect/platform-node/NodeRuntime#runMain",
          "@effect/platform-node/NodeServices#layer",
          "effect/Crypto#Crypto",
          "effect/Crypto#make",
          "effect/encoding/Ndjson#decode",
          "effect/encoding/Ndjson#encode",
          "effect/FileSystem#FileSystem",
          "effect/http/FetchHttpClient#Fetch",
          "effect/http/FetchHttpClient#layer",
          "effect/http/HttpBody#raw",
          "effect/http/HttpClient#execute",
          "effect/http/HttpClient#get",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClientRequest#fromWeb",
          "effect/http/HttpClientResponse#HttpClientResponse",
          "effect/http/HttpClientRequest#get",
          "effect/http/HttpClientRequest#post",
          "effect/http/HttpClientRequest#setBody",
          "effect/http/HttpClientRequest#setHeaders",
          "effect/http/HttpEffect#fromWebHandler",
          "effect/http/HttpServer#HttpServer",
          "effect/http/HttpServer#serve",
          "effect/http/HttpServerRequest#HttpServerRequest",
          "effect/http/HttpServerResponse#empty",
          "effect/http/HttpServerResponse#text",
          "effect/net/NetAddress#isInetAddress",
          "effect/net/NetAddress#isUnixPathAddress",
          "effect/observability/OtlpExporter#Flusher",
          "effect/observability/OtlpLogger#layer",
          "effect/observability/OtlpMetrics#layer",
          "effect/observability/OtlpSerialization#layerJson",
          "effect/observability/OtlpTracer#layer",
          "effect/Path#Path",
          "effect/PlatformError#PlatformError",
          "effect/process/ChildProcess#make",
          "effect/process/ChildProcessSpawner#ChildProcessHandle",
          "effect/process/ChildProcessSpawner#ChildProcessSpawner"
        ]
      }
    ]
  }
}
