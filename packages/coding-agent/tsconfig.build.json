{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@msa/agent-core": ["../agent/dist/index.d.ts"],
      "@msa/agent-core/*": ["../agent/dist/*.d.ts"],
      "@msa/ai": ["../ai/dist/index.d.ts"],
      "@msa/ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
      "@msa/tui": ["../tui/dist/index.d.ts"],
      "@msa/tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
    },
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "src/experimental"]
}
