{
  "name": "@earendil-works/pi-env",
  "version": "1.2.0",
  "description": "Remote execution environments for Pi Durable: a small daemon deployed over SSH and its ExecutionEnv client",
  "keywords": [
    "agents",
    "durable-execution",
    "remote",
    "ssh"
  ],
  "license": "MIT",
  "author": "Earendil Works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi.git",
    "directory": "packages/env"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "build:daemon": "cargo build --manifest-path daemon/Cargo.toml --locked",
    "test": "vitest --run"
  },
  "dependencies": {
    "@earendil-works/chord": "workspace:*",
    "@earendil-works/pi-durable": "workspace:*"
  },
  "devDependencies": {
    "shx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
